{
  "name": "pi-herdr-outliner",
  "version": "0.1.1",
  "description": "Persistent local-first block outliner shared by Herdr users and Pi agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/float-ritual-stack/pi-herdr-outliner.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "outliner": "bun run src/outliner.ts",
    "profile:tree": "bun run scripts/profile-tree.ts",
    "server": "bun run src/server-main.ts",
    "cli": "bun run src/cli.ts",
    "workflow": "bun run src/workflow-main.ts",
    "goto": "bun run src/cli.ts goto",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:e2e:herdr": "bun run test/e2e/startup-interruption.ts && bun run test/e2e/resource-authoring.ts",
    "test:e2e:ownership": "bun run test/e2e/workspace-ownership.ts",
    "test:e2e:capture": "bun run test/e2e/capture-retry.ts",
    "test:e2e:edit-conflicts": "bun run test/e2e/edit-conflicts.ts",
    "test:e2e:file-revisions": "bun run test/e2e/file-revisions.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "callscript": "^0.1.0",
    "marked": "18.0.5",
    "pdfjs-dist": "^6.3.289",
    "typebox": "^1.0.44"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@xterm/headless": "6.0.0",
    "typescript": "^5.9.3"
  }
}
